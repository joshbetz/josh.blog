{
  "version": 2,
  "settings": {
    "layout": {
      "contentSize": "calc(60ch - 40px)",
      "wideSize": "calc(78ch - 52px)"
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "typography": {
      "fontFamily": "Montserrat, Verdana, sans-serif"
    },
    "blocks": {
      "core/code": {
        "border": {
          "width": "0"
        }
      }
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "20px",
        "bottom": "0",
        "left": "20px"
      }
    }
  }
}
